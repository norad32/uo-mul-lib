{
  "version": 6,
  "configurePresets": [
    {
      "name": "common",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_WITH_INSTALL_RPATH": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (Ninja)",
      "inherits": "common",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "$env{HOME}/.local",
        "ENABLE_COVERAGE": "ON",
        "BUILD_TESTS": "ON",
        "BUILD_GUI": "ON",
        "ENABLE_CLANG_TIDY": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "1",
        "BUILD_GUI_RUNTIME": "OFF",
        "INSTALL_GUI": "ON"
      }
    },
    {
      "name": "debug-gui",
      "displayName": "Debug GUI (Ninja)",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/debug-gui",
      "cacheVariables": {
        "BUILD_CLI": "ON",
        "BUILD_GUI": "ON",
        "BUILD_CORE_TESTS": "OFF",
        "BUILD_CLI_TESTS": "OFF",
        "BUILD_GUI_TESTS": "ON"
      }
    },
    {
      "name": "debug-cli",
      "displayName": "Debug CLI (Ninja)",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/debug-cli",
      "cacheVariables": {
        "BUILD_GUI": "OFF",
        "BUILD_CLI": "ON",
        "BUILD_CORE_TESTS": "OFF",
        "BUILD_CLI_TESTS": "ON",
        "BUILD_GUI_TESTS": "OFF",
        "INSTALL_GUI": "OFF"
      }
    },
    {
      "name": "debug-gui-tidy",
      "displayName": "Debug GUI with clang-tidy (Ninja)",
      "inherits": "debug-gui",
      "binaryDir": "${sourceDir}/build/debug-gui-tidy",
      "cacheVariables": {
        "ENABLE_CLANG_TIDY": "ON"
      }
    },
    {
      "name": "debug-uomul",
      "displayName": "Debug uomul (Ninja)",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/debug-uomul",
      "cacheVariables": {
        "BUILD_CLI": "OFF",
        "BUILD_GUI": "OFF",
        "BUILD_TESTS": "ON",
        "BUILD_CORE_TESTS": "ON",
        "BUILD_CLI_TESTS": "OFF",
        "BUILD_GUI_TESTS": "OFF",
        "INSTALL_GUI": "OFF"
      }
    },
    {
      "name": "debug-headless",
      "displayName": "Debug Headless (Ninja)",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/debug-headless",
      "cacheVariables": {
        "BUILD_GUI": "OFF",
        "BUILD_CORE_TESTS": "ON",
        "BUILD_CLI_TESTS": "ON",
        "BUILD_GUI_TESTS": "OFF",
        "INSTALL_GUI": "OFF"
      }
    },
    {
      "name": "release-base",
      "hidden": true,
      "inherits": "common",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_COVERAGE": "OFF",
        "BUILD_TESTS": "ON",
        "ENABLE_CLANG_TIDY": "OFF",
        "INSTALL_GUI": "OFF"
      }
    },
    {
      "name": "release-gui",
      "displayName": "Release GUI (Ninja)",
      "inherits": "release-base",
      "binaryDir": "${sourceDir}/build/release-gui",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/install/release-gui",
        "BUILD_GUI_RUNTIME": "ON",
        "BUILD_GUI": "ON",
        "BUILD_CORE_TESTS": "ON",
        "BUILD_CLI_TESTS": "ON",
        "BUILD_GUI_TESTS": "ON"
      }
    },
    {
      "name": "release-cli",
      "displayName": "Release CLI (Ninja)",
      "inherits": "release-base",
      "binaryDir": "${sourceDir}/build/release-cli",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/install/release-cli",
        "BUILD_CLI": "ON",
        "BUILD_GUI": "OFF",
        "BUILD_CORE_TESTS": "OFF",
        "BUILD_CLI_TESTS": "ON",
        "BUILD_GUI_TESTS": "OFF"
      }
    },
    {
      "name": "release-uomul",
      "displayName": "Release uomul (Ninja)",
      "inherits": "release-base",
      "binaryDir": "${sourceDir}/build/release-uomul",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/install/release-uomul",
        "BUILD_CLI": "OFF",
        "BUILD_GUI": "OFF",
        "BUILD_CORE_TESTS": "ON",
        "BUILD_CLI_TESTS": "OFF",
        "BUILD_GUI_TESTS": "OFF"
      }
    },
    {
      "name": "release-headless",
      "displayName": "Release Headless (Ninja)",
      "inherits": "release-base",
      "binaryDir": "${sourceDir}/build/release-headless",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/install/release-headless",
        "BUILD_GUI": "OFF",
        "BUILD_GUI_RUNTIME": "OFF",
        "BUILD_CORE_TESTS": "ON",
        "BUILD_CLI_TESTS": "ON",
        "BUILD_GUI_TESTS": "OFF"
      }
    },
    {
      "name": "release-map-benchmarks",
      "displayName": "Release Map Benchmarks (Ninja)",
      "inherits": "release-base",
      "binaryDir": "${sourceDir}/build/release-map-benchmarks",
      "cacheVariables": {
        "BUILD_GUI": "OFF",
        "BUILD_TESTS": "OFF",
        "BUILD_BENCHMARKS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "targets": ["uo-mule"]
    },
    {
      "name": "debug-gui",
      "configurePreset": "debug-gui",
      "targets": ["uo-mule"]
    },
    {
      "name": "debug-cli",
      "configurePreset": "debug-cli",
      "targets": ["uo-mule"]
    },
    {
      "name": "debug-gui-tidy",
      "configurePreset": "debug-gui-tidy",
      "targets": ["uo-mule"]
    },
    {
      "name": "debug-uomul",
      "configurePreset": "debug-uomul",
      "targets": ["uomul_tests"]
    },
    {
      "name": "debug-headless",
      "configurePreset": "debug-headless",
      "targets": ["uo-mule"]
    },
    {
      "name": "release-gui",
      "configurePreset": "release-gui",
      "targets": ["all"]
    },
    {
      "name": "release-cli",
      "configurePreset": "release-cli",
      "targets": ["uo-mule"]
    },
    {
      "name": "release-uomul",
      "configurePreset": "release-uomul",
      "targets": ["uomul_tests"]
    },
    {
      "name": "release-headless",
      "configurePreset": "release-headless",
      "targets": ["all"]
    },
    {
      "name": "release-map-benchmarks",
      "configurePreset": "release-map-benchmarks"
    }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug",
      "inherits": "test-base",
      "configurePreset": "debug"
    },
    {
      "name": "debug-gui",
      "inherits": "test-base",
      "configurePreset": "debug-gui"
    },
    {
      "name": "debug-cli",
      "inherits": "test-base",
      "configurePreset": "debug-cli"
    },
    {
      "name": "debug-uomul",
      "inherits": "test-base",
      "configurePreset": "debug-uomul"
    },
    {
      "name": "debug-headless",
      "inherits": "test-base",
      "configurePreset": "debug-headless"
    },
    {
      "name": "release-gui",
      "inherits": "test-base",
      "configurePreset": "release-gui"
    },
    {
      "name": "release-cli",
      "inherits": "test-base",
      "configurePreset": "release-cli"
    },
    {
      "name": "release-uomul",
      "inherits": "test-base",
      "configurePreset": "release-uomul"
    },
    {
      "name": "release-headless",
      "inherits": "test-base",
      "configurePreset": "release-headless"
    },
    {
      "name": "release-map-benchmarks",
      "inherits": "test-base",
      "configurePreset": "release-map-benchmarks"
    }
  ]
}
